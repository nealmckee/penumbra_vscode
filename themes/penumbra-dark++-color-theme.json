  "tokenColors": [
    {
      "name": "Comments & Marginalia",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#575b62"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#8a90d4"
      }
    },
    {
      "name": "Storage & Type Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.storage"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#8a90d4"
      }
    },
    {
      "name": "Functions & Method Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#009edb"
      }
    },
    {
      "name": "Types, Classes, Structs & Modules",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#b4a724"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#00a8a4"
      }
    },
    {
      "name": "Syntactic Punctuation & Brackets",
      "scope": [
        "punctuation",
