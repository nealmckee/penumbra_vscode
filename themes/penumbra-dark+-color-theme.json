  "tokenColors": [
    {
      "name": "Comments & Marginalia",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#5b5d62"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#7d82c0"
      }
    },
    {
      "name": "Storage & Type Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.storage"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#7d82c0"
      }
    },
    {
      "name": "Functions & Method Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#008fc6"
      }
    },
    {
      "name": "Types, Classes, Structs & Modules",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#a39720"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#009894"
      }
    },
    {
      "name": "Syntactic Punctuation & Brackets",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#999999"
      }
    },
    {
      "name": "Embedded & Template Interpolation Delimiters",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#009894"
      }
